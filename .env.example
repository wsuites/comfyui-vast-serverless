# Copy this file to .env and fill in the values.
# .env is in .gitignore: NEVER commit it to a repo or include it in a zip.

# --- Cloudflare R2 (models and provisioning script) -------------------------
# Only renew_provisioning.py needs these to upload the script.
# Workers do NOT read them from here: they take them from the Vast account
# environment variables (`vastai show env-vars`).
S3_BUCKET_NAME=my-bucket
S3_ENDPOINT_URL=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Public Development URL of the bucket.
# R2 -> bucket -> Settings -> Public Development URL -> Enable.
# Permanent and without query string, unlike a presigned URL.
R2_PUBLIC_BASE=https://pub-XXXXXXXXXXXXXXXX.r2.dev
R2_PROVISION_KEY=comfy-stack/scripts/serverless_provision.sh

# --- Vast.ai deployment identifiers -----------------------------------------
# Get them with: vastai show endpoints / show workergroups / search templates
VAST_ENDPOINT_NAME=my-endpoint
VAST_ENDPOINT_ID=0
VAST_WORKERGROUP_ID=0
VAST_TEMPLATE_ID=0
VAST_TEMPLATE_NAME=ComfyUI Serverless
VAST_CREATOR_ID=0

# --- Template parameters -----------------------------------------------------
VAST_IMAGE=vastai/comfy
VAST_IMAGE_TAG=v0.30.0-cuda-13.2-py312
VAST_HF_TOKEN=hf_placeholder_not_used

# Disk ALLOCATED per worker, in GB. You pay 24/7 per allocated GB, not used.
# Measured: image + venv + models + nodes take ~14 GB, and with 16 the worker
# sat at 91%. Asking for more does NOT reduce offers (pool machines have
# between 288 and 1352 GB): the only thing that changes is storage_cost x GB.
#
# Raised 18 -> 26 for FEAT_ANIMA: Anima is a second full model stack (2B DiT +
# Qwen3-0.6B encoder + Qwen-Image VAE, ~5.6 GB) living alongside the SDXL one.
# Measured on the live worker at 18 GB: 13.9 used, 4.1 free -- Anima did not
# fit. 26 leaves ~6 GB of headroom with both stacks installed.
# Keep disk_space>= in VAST_SEARCH_PARAMS in sync with this number, or the
# autoscaler filters for machines that cannot host what it then allocates.
VAST_DISK_SPACE=26

# Offer filters. See the "Costs" section of the README before touching them.
#
# `verified` is a real trade-off, not a free win (measured 2026-09-22):
#   - WITH verified=true the pool can drop to 2 offers, which is the dangerous
#     region: with a single viable offer the autoscaler relaxes the price
#     ceiling and rents above dph_total.
#   - WITHOUT it you get ~7 offers but also hosts whose forwarded ports are
#     filtered: the worker provisions, reports idle, and receives zero
#     requests. `machine_id notin [...]` is how those are vetoed as they are
#     found.
# The README section "`inet_down` / `inet_up` do not filter for a usable
# network" shows why no field in the offer can screen this for you; the
# runtime protections (resumable downloads, per-route probe, HF fallback) plus
# the veto list are what actually work.
# `storage_cost<=0.20` caps disk at $3.60/month at 18 GB; stricter leaves ONE
# offer and triggers the same price-ceiling relaxation.
VAST_SEARCH_PARAMS=gpu_ram>=16 num_gpus=1 dlperf>=70 disk_space>=26 storage_cost<=0.20 inet_down_cost<=0.005 dph_total<=0.15 rentable=true machine_id notin []

# --- Client ------------------------------------------------------------------
# If not defined, ~/.config/vastai/vast_api_key is used
# VAST_API_KEY=

# Discord webhook for worker notifications (optional; empty = no notifications)
DISCORD_WEBHOOK=

# --- Local web UI (apps/web, Astro) -------------------------------------------
# The FastAPI process binds to loopback only; Astro is the public face and is
# the layer that asks for credentials. Never expose API_PORT through the tunnel.
API_HOST=127.0.0.1
API_PORT=8800
WEB_HOST=127.0.0.1
WEB_PORT=4321
# HTTP Basic Auth for the web UI. `cv web up` refuses to open a tunnel while
# WEBAPP_PASS is empty and WEBAPP_AUTH is not explicitly off.
WEBAPP_AUTH=on
WEBAPP_USER=admin
WEBAPP_PASS=

# Cap on output/web, oldest job directories deleted first once it is exceeded.
# Nothing else reclaims that directory, and on a small VPS a full disk stops
# the page serving at all. 0 disables.
WEB_RETENTION_GB=5

# --- Cloudflare tunnel --------------------------------------------------------
# Leave CF_TUNNEL_NAME empty for a quick (ephemeral trycloudflare.com) tunnel.
CLOUDFLARED_BIN=cloudflared
CF_TUNNEL_NAME=
CF_TUNNEL_HOSTNAME=

# Worker serving tunnel: makes the pyworker reachable through Cloudflare on
# hosts that firewall their forwarded ports (see the README, "Worker tunnel").
# This is the NON-secret half. One-time setup:
#   cloudflared tunnel login
#   cloudflared tunnel create pyworker-vast
#   cloudflared tunnel route dns pyworker-vast pyworker-vast.<your-domain>
# The tunnel's name and the hostname it serves are independent; only the
# hostname below is load-bearing, so an existing tunnel can serve a renamed
# host with one `route dns` and no new token.
# The matching token is a SECRET and must be a Vast ACCOUNT env var (masked in
# `vastai show env-vars`), never in this file or the template:
#   cloudflared tunnel token pyworker-vast
#   vastai create env-var CF_WORKER_TOKEN <token>
# Leave empty to disable: the boot is then byte-identical to no tunnel.
CF_WORKER_HOSTNAME=

# --- CLI ----------------------------------------------------------------------
# Private key used by `cv instance ssh`; Vast serves the matching public key.
SSH_KEY=~/.ssh/id_ed25519
# Python interpreter the CLI shells out to for workflow building and rendering.
PYTHON_BIN=python
# Where `cv gen` and `cv gallery` look for rendered images.
GALLERY_DIR=output
