# Copia este fichero a .env y rellena los valores.
# .env esta en .gitignore: NUNCA lo subas a un repo ni lo metas en un zip.

# --- Cloudflare R2 (modelos y script de provisioning) ---------------------
# Solo las necesita renew_provisioning.py para subir el script.
# Los workers NO las leen de aqui: las coge de las variables de entorno de
# cuenta de Vast (`vastai show env-vars`).
S3_BUCKET_NAME=mi-bucket
S3_ENDPOINT_URL=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Public Development URL del bucket.
# R2 -> bucket -> Settings -> Public Development URL -> Enable.
# Permanente y sin query string, a diferencia de una presigned.
R2_PUBLIC_BASE=https://pub-XXXXXXXXXXXXXXXX.r2.dev
R2_PROVISION_KEY=comfy-stack/scripts/serverless_provision.sh

# --- Identificadores del despliegue en Vast.ai ----------------------------
# Se obtienen con: vastai show endpoints / show workergroups / search templates
VAST_ENDPOINT_NAME=mi-endpoint
VAST_ENDPOINT_ID=0
VAST_WORKERGROUP_ID=0
VAST_TEMPLATE_ID=0
VAST_TEMPLATE_NAME=ComfyUI Serverless
VAST_CREATOR_ID=0

# --- Parametros del template ----------------------------------------------
VAST_IMAGE=vastai/comfy
VAST_IMAGE_TAG=v0.30.0-cuda-13.2-py312
VAST_HF_TOKEN=hf_placeholder_not_used

# Disco ASIGNADO por worker, en GB. Se paga 24/7 por GB asignado, no usado.
# Medido: imagen + venv + modelos + nodos ocupan ~14 GB, y con 16 el worker se
# quedaba al 91%. Pedir mas NO reduce las ofertas (las maquinas del pool tienen
# entre 288 y 1352 GB): lo unico que cambia es storage_cost x GB.
VAST_DISK_SPACE=24

# Filtros de oferta. Ver la seccion "Costes" del README antes de tocarlos.
# storage_cost<=0.11 topa el disco en $2,64/mes a 24 GB manteniendo 7 ofertas.
# No bajarlo mas: a <=0.0625 queda UNA sola oferta y entonces el autoscaler
# relaja el tope de precio y alquila por encima de dph_total.
VAST_SEARCH_PARAMS=gpu_ram>=16 num_gpus=1 dlperf>=70 disk_space>=24 storage_cost<=0.11 inet_down_cost<=0.005 dph_total<=0.15 rentable=true

# --- Cliente ---------------------------------------------------------------
# Si no se define, se usa ~/.config/vastai/vast_api_key
# VAST_API_KEY=
